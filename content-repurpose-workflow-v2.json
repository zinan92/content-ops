      "x": 500,
      "y": 600,
      "w": 580,
      "h": 110,
      "body": [
        "polish_xiaohongshu_drafts.py",
        "CARD_PLAN_TEMPLATES：conclusion_first / suspense_first",
        "卡片角色化：cover / misunderstanding / reasoning / method / ..."
      ]
    },
    {
      "id": "xhs_layer1",
      "lane": "xhs",
      "role": "decision",
      "type": "script",
      "title": "Layer 1 硬 fail（本次新增）",
      "x": 500,
      "y": 730,
      "w": 580,
      "h": 140,
      "body": [
        "quality_xiaohongshu_drafts.py（瘦身后 310 行）",
        "字符串 marker leak / 口播残留 / ops 泄漏",
        "卡片字数 70-260 / 角色齐全 / 与 source 重合度",
        "不过 → 直接进 action queue，不进 Layer 2"
      ]
    },
    {
      "id": "xhs_layer2",
      "lane": "xhs",
      "role": "decision",
      "type": "ai",
      "title": "Layer 2 dbs 9 维评分（本次新增）",
      "x": 500,
      "y": 890,
      "w": 580,
      "h": 160,
      "body": [
        "dbs_xhs_review.py + claude -p 子进程 + Sonnet",
        "9 维：痛点 / 独立 / 可信 / 反常识 / 冲突 / 主张 / 悬念 / 张力 / 落差",
        "verdict ∈ keep / rewrite / kill；suspense.structural 标模板锁",
        "$0.18/篇，~60s"
      ]
    },
    {
      "id": "xhs_render",
      "lane": "xhs",
      "role": "process",
      "type": "script",
